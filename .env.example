# Copy this file to .env and fill in your values. Never commit .env.

# LLM parser (step 4) - fill in whichever provider you choose
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding model used by the matcher (step 5)
EMBEDDING_MODEL=BAAI/bge-m3

# SQLite database path
DB_PATH=data/foods.db
