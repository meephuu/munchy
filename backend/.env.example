# Copy this file to .env and fill in your values. Never commit .env.

# LLM parser (step 4) - fill in whichever provider you choose
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
# Used once when the main model answers 503 (overloaded) or 429 (rate limit); leave blank to turn off
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
GEMINI_API_KEY=

# Self-hosted alternative (step 15): set LLM_PROVIDER=ollama, install Ollama, then
#   ollama pull qwen2.5:7b      (or a Thai-tuned model such as a Typhoon build)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
ANTHROPIC_API_KEY=

# Embedding model used by the matcher (step 5)
EMBEDDING_MODEL=BAAI/bge-m3

# SQLite database path
DB_PATH=data/foods.db

# Browser origins allowed to call the API (step 14), comma-separated
CORS_ORIGINS=http://localhost:3000

# Parse cache (step 10): remembers LLM parse results so repeated dishes skip the API.
# Safe to delete at any time.
CACHE_PATH=data/cache.db
