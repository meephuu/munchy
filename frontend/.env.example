# Where the backend (uvicorn src.api:app) listens; used by server code only.
BACKEND_URL=http://127.0.0.1:8000

# Accounts: your Supabase project URL and publishable key (the dashboard's "Connect" button shows both
# lines ready to paste). The older name NEXT_PUBLIC_SUPABASE_ANON_KEY also works. Both values are safe to
# expose to the browser; never put the secret / service_role key here. See ../supabase/README.md.
# Leave empty and the guest screens still work; sign-up and log-in say accounts are not switched on.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
