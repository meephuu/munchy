# Where the backend (uvicorn src.api:app) listens; used by server code only.
BACKEND_URL=http://127.0.0.1:8000

# Accounts: Supabase project URL and anon / publishable key (Project Settings -> API). Both are safe to
# expose to the browser; never put the service_role key here. See ../supabase/README.md.
# Leave empty and the guest screens still work; sign-up and log-in say accounts are not switched on.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
